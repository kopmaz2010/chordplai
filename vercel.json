{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.chordplai.com" }],
      "destination": "https://chordplai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.chordplai.com" }],
      "destination": "https://chordplai.com/:path*",
      "permanent": true
    }
  ]
}
